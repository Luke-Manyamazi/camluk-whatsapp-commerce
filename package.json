{
  "name": "camluk-whatsapp-commerce",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp-first business automation platform for Camluk Technologies.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=@camluk/api",
    "build": "npm install --include=dev && npm run build --workspace=web",
    "start": "npm start --workspace=web",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "supabase": "2.117.0"
  }
}
